{
  "manifest_version": 3,
  "name": "Keep Password",
  "version": "0.9.0",
  "key": "",
  "description": "聚焦密码框后显示 Keep Password 候选账号，经短密钥确认后填入登录信息",
  "permissions": ["nativeMessaging", "storage"],
  "action": {
    "default_title": "填充 Keep Password"
  },
  "commands": {
    "fill-password": {
      "suggested_key": {
        "default": "Ctrl+Shift+L"
      },
      "description": "填充当前聚焦的密码框"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["chooser.html"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
