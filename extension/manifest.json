{
  "manifest_version": 3,
  "name": "Keep Password",
  "version": "0.3.1",
  "description": "在你确认后，为当前聚焦的密码框填入 Keep Password 中的登录信息",
  "permissions": ["nativeMessaging"],
  "action": {
    "default_title": "填充 Keep Password"
  },
  "commands": {
    "fill-password": {
      "suggested_key": {
        "default": "Ctrl+Shift+L"
      },
      "description": "填充当前聚焦的密码框"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
