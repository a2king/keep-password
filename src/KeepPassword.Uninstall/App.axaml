<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KeepPassword.Uninstall.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter, Segoe UI Variable, Microsoft YaHei UI, sans-serif" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Background" Value="#151B2B" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#0572EC" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#D14343" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#152033" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#152033" />
    </Style>
  </Application.Styles>
</Application>
