<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KeepPassword.App.App">
  <Application.Resources>
    <ResourceDictionary>
      <!-- 字体配置：程序员钟爱的等宽字体栈与现代UI字体栈 -->
      <FontFamily x:Key="Kp.Font.Ui">Inter, Segoe UI Variable, Microsoft YaHei UI, PingFang SC, -apple-system, sans-serif</FontFamily>
      <FontFamily x:Key="Kp.Font.Mono">JetBrains Mono, Cascadia Code, Fira Code, Consolas, Courier New, monospace</FontFamily>

      <!-- 矢量图标资源 -->
      <StreamGeometry x:Key="Icon.Vault">M12.65 10A5.99 5.99 0 0 0 7 6a6 6 0 1 0 5.65 8H17v4h4v-4h2v-4H12.65zM7 14a2 2 0 1 1 0-4 2 2 0 0 1 0 4z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Generator">M7.5 5.6L5 7l1.4-2.5L5 2l2.5 1.4L10 2l-1.4 2.5L10 7 7.5 5.6zm12 9.8L17 14l1.4 2.5L17 19l2.5-1.4L22 19l-1.4-2.5L22 14l-2.5 1.4zM16.2 3.8l4 4-13.4 13.4-4-4L16.2 3.8zm1.4-1.4a1.4 1.4 0 0 1 2 0l2 2a1.4 1.4 0 0 1 0 2l-2 2-4-4 2-2z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Totp">M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8zm.5-13H11v6l5.2 3.1.8-1.2-4.5-2.7V7z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Settings">M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.49.49 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.48.48 0 0 0-.48-.41h-3.84c-.24 0-.45.17-.48.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.49.49 0 0 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Audit">M12 2L4 5v6.09c0 5.05 3.41 9.76 8 10.91 4.59-1.15 8-5.86 8-10.91V5l-8-3zm-1 5h2v6h-2V7zm0 8h2v2h-2v-2z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Breach">M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm1 14.93V17a1 1 0 0 1-2 0v-.07A8 8 0 0 1 4.07 13H5a1 1 0 0 1 0-2h-.93A8 8 0 0 1 11 4.07V5a1 1 0 0 1 2 0v-.93A8 8 0 0 1 19.93 11H19a1 1 0 0 1 0 2h.93A8 8 0 0 1 13 16.93z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Lock">M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Theme">M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Copy">M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Search">M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Add">M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Refresh">M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Trash">M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Eye">M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Check">M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z</StreamGeometry>

      <!-- 主题资源字典（支持明暗无缝切换） -->
      <ResourceDictionary.ThemeDictionaries>
        <!-- 浅色现代风格 (Clean Light) -->
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Kp.Bg" Color="#F4F6F9" />
          <SolidColorBrush x:Key="Kp.Sidebar" Color="#0F172A" />
          <SolidColorBrush x:Key="Kp.SidebarHover" Color="#1E293B" />
          <SolidColorBrush x:Key="Kp.SidebarActive" Color="#2563EB" />
          <SolidColorBrush x:Key="Kp.SidebarText" Color="#94A3B8" />
          <SolidColorBrush x:Key="Kp.SidebarTextActive" Color="#FFFFFF" />
          <SolidColorBrush x:Key="Kp.Surface" Color="#FFFFFF" />
          <SolidColorBrush x:Key="Kp.SurfaceElevated" Color="#F8FAFC" />
          <SolidColorBrush x:Key="Kp.SurfaceMuted" Color="#F1F5F9" />
          <SolidColorBrush x:Key="Kp.Border" Color="#E2E8F0" />
          <SolidColorBrush x:Key="Kp.BorderSubtle" Color="#F1F5F9" />
          <SolidColorBrush x:Key="Kp.Accent" Color="#2563EB" />
          <SolidColorBrush x:Key="Kp.AccentHover" Color="#1D4ED8" />
          <SolidColorBrush x:Key="Kp.AccentSoft" Color="#EFF6FF" />
          <SolidColorBrush x:Key="Kp.Text" Color="#0F172A" />
          <SolidColorBrush x:Key="Kp.TextMuted" Color="#64748B" />
          <SolidColorBrush x:Key="Kp.Danger" Color="#DC2626" />
          <SolidColorBrush x:Key="Kp.DangerHover" Color="#B91C1C" />
          <SolidColorBrush x:Key="Kp.DangerSoft" Color="#FEF2F2" />
          <SolidColorBrush x:Key="Kp.Warning" Color="#D97706" />
          <SolidColorBrush x:Key="Kp.Success" Color="#16A34A" />
          <SolidColorBrush x:Key="Kp.Selection" Color="#EFF6FF" />
          <SolidColorBrush x:Key="Kp.SelectionBorder" Color="#BFDBFE" />
          <SolidColorBrush x:Key="Kp.CardShadow" Color="#0D0F172A" />
          <SolidColorBrush x:Key="Kp.BadgeBg" Color="#E0E7FF" />
          <SolidColorBrush x:Key="Kp.BadgeFg" Color="#3730A3" />
        </ResourceDictionary>

        <!-- 极客深色风格 (Geek Dark) -->
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Kp.Bg" Color="#0B0F17" />
          <SolidColorBrush x:Key="Kp.Sidebar" Color="#111622" />
          <SolidColorBrush x:Key="Kp.SidebarHover" Color="#1C2333" />
          <SolidColorBrush x:Key="Kp.SidebarActive" Color="#2563EB" />
          <SolidColorBrush x:Key="Kp.SidebarText" Color="#8B949E" />
          <SolidColorBrush x:Key="Kp.SidebarTextActive" Color="#FFFFFF" />
          <SolidColorBrush x:Key="Kp.Surface" Color="#151C28" />
          <SolidColorBrush x:Key="Kp.SurfaceElevated" Color="#1C2433" />
          <SolidColorBrush x:Key="Kp.SurfaceMuted" Color="#111722" />
          <SolidColorBrush x:Key="Kp.Border" Color="#252F42" />
          <SolidColorBrush x:Key="Kp.BorderSubtle" Color="#1C2433" />
          <SolidColorBrush x:Key="Kp.Accent" Color="#3B82F6" />
          <SolidColorBrush x:Key="Kp.AccentHover" Color="#60A5FA" />
          <SolidColorBrush x:Key="Kp.AccentSoft" Color="#172554" />
          <SolidColorBrush x:Key="Kp.Text" Color="#F1F5F9" />
          <SolidColorBrush x:Key="Kp.TextMuted" Color="#94A3B8" />
          <SolidColorBrush x:Key="Kp.Danger" Color="#EF4444" />
          <SolidColorBrush x:Key="Kp.DangerHover" Color="#F87171" />
          <SolidColorBrush x:Key="Kp.DangerSoft" Color="#3F1517" />
          <SolidColorBrush x:Key="Kp.Warning" Color="#F59E0B" />
          <SolidColorBrush x:Key="Kp.Success" Color="#10B981" />
          <SolidColorBrush x:Key="Kp.Selection" Color="#1A2742" />
          <SolidColorBrush x:Key="Kp.SelectionBorder" Color="#2563EB" />
          <SolidColorBrush x:Key="Kp.CardShadow" Color="#40000000" />
          <SolidColorBrush x:Key="Kp.BadgeBg" Color="#1E2B4A" />
          <SolidColorBrush x:Key="Kp.BadgeFg" Color="#93C5FD" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource Kp.Font.Ui}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Background" Value="{DynamicResource Kp.Bg}" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.Text}" />
    </Style>

    <!-- 主操作按钮 (Accent Button) -->
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{DynamicResource Kp.Accent}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.AccentHover}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.accent:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.Accent}" />
      <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- 描边按钮 (Outline Button) -->
    <Style Selector="Button.outline">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.Accent}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.outline:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.AccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.AccentHover}" />
    </Style>

    <!-- 幽灵按钮 (Ghost Button) -->
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.Text}" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.SurfaceMuted}" />
    </Style>

    <!-- 柔和浅底按钮 (Soft Button) -->
    <Style Selector="Button.soft">
      <Setter Property="Background" Value="{DynamicResource Kp.SurfaceMuted}" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.Text}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.soft:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.SurfaceElevated}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.Border}" />
    </Style>

    <!-- 危险操作按钮 (Danger Button) -->
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.Danger}" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.DangerSoft}" />
    </Style>

    <!-- 侧栏导航胶囊按钮 (Sidebar Nav Button) -->
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.SidebarText}" />
      <Setter Property="Padding" Value="8,10" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Margin" Value="8,3" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.SidebarHover}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.nav.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.SidebarActive}" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.SidebarTextActive}" />
    </Style>

    <!-- 条目列表卡片按钮 (Vault Entry Item Button) -->
    <Style Selector="Button.entry">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.Text}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Margin" Value="4,2" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.entry:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.SurfaceMuted}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.Border}" />
    </Style>
    <Style Selector="Button.entry.selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.Selection}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.SelectionBorder}" />
    </Style>

    <!-- 分类与账号卡片 -->
    <Style Selector="Button.filter-card, Button.account-card">
      <Setter Property="Background" Value="{DynamicResource Kp.Surface}" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.Text}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.filter-card:pointerover /template/ ContentPresenter, Button.account-card:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.SurfaceMuted}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.SelectionBorder}" />
    </Style>
    <Style Selector="Button.filter-card.selected /template/ ContentPresenter, Button.account-card.selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.Selection}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.Accent}" />
    </Style>
    <Style Selector="Border.count-badge">
      <Setter Property="Background" Value="{DynamicResource Kp.BadgeBg}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.count-badge > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Kp.BadgeFg}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.chip">
      <Setter Property="Background" Value="{DynamicResource Kp.Surface}" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.Text}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.chip:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.SurfaceMuted}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.SelectionBorder}" />
    </Style>
    <Style Selector="Button.chip.selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.AccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.Accent}" />
    </Style>

    <!-- 输入框基础样式 (TextBox) -->
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.Border}" />
      <Setter Property="Background" Value="{DynamicResource Kp.SurfaceMuted}" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.Text}" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="FontSize" Value="13.5" />
    </Style>
    <Style Selector="TextBox:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.Accent}" />
      <Setter Property="Background" Value="{DynamicResource Kp.Surface}" />
    </Style>
    <Style Selector="TextBox.mono">
      <Setter Property="FontFamily" Value="{StaticResource Kp.Font.Mono}" />
      <Setter Property="LetterSpacing" Value="0.5" />
    </Style>

    <!-- 文本排版样式 (Typography) -->
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.Text}" />
      <Setter Property="LetterSpacing" Value="-0.3" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.Text}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource Kp.TextMuted}" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource Kp.TextMuted}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,10,0,6" />
    </Style>
    <Style Selector="TextBlock.domain">
      <Setter Property="Foreground" Value="{DynamicResource Kp.TextMuted}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="14,14,14,4" />
      <Setter Property="LetterSpacing" Value="0.6" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="{StaticResource Kp.Font.Mono}" />
    </Style>

    <!-- 容器与卡片样式 (Containers) -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource Kp.Surface}" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="BoxShadow" Value="0 16 36 0 #26000000" />
      <Setter Property="Padding" Value="28" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.Border}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource Kp.Surface}" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Border.field">
      <Setter Property="Background" Value="{DynamicResource Kp.SurfaceElevated}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="Border.audit-card">
      <Setter Property="Background" Value="{DynamicResource Kp.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16,12" />
    </Style>
    <Style Selector="TextBlock.danger">
      <Setter Property="Foreground" Value="{DynamicResource Kp.Danger}" />
    </Style>
    <Style Selector="TextBlock.success">
      <Setter Property="Foreground" Value="{DynamicResource Kp.Success}" />
    </Style>
    <Style Selector="TextBlock.warning">
      <Setter Property="Foreground" Value="{DynamicResource Kp.Warning}" />
    </Style>

    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Kp.Text}" />
    </Style>
  </Application.Styles>
</Application>
