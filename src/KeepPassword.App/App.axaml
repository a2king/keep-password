  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource Kp.Font.Ui}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Background" Value="{DynamicResource Kp.Bg}" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.Text}" />
    </Style>

    <!-- 主操作按钮 (Accent Button) -->
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{DynamicResource Kp.Accent}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.AccentHover}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.accent:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.Accent}" />
      <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- 描边按钮 (Outline Button) -->
    <Style Selector="Button.outline">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.Accent}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.outline:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.AccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.AccentHover}" />
    </Style>

    <!-- 幽灵按钮 (Ghost Button) -->
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.Text}" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.SurfaceMuted}" />
    </Style>

    <!-- 字段行内的图标按钮（复制 / 显示 / 生成 / 删除） -->
    <Style Selector="Button.icon">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.TextMuted}" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.icon PathIcon">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
    </Style>
    <Style Selector="Button.icon /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.SurfaceMuted}" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.Accent}" />
    </Style>
    <Style Selector="Button.icon:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.Selection}" />
    </Style>
    <Style Selector="Button.icon.icon-danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.DangerSoft}" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.Danger}" />
    </Style>

    <!-- 柔和浅底按钮 (Soft Button) -->
    <Style Selector="Button.soft">
      <Setter Property="Background" Value="{DynamicResource Kp.SurfaceMuted}" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.Text}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.soft:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.SurfaceElevated}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.Border}" />
    </Style>

    <!-- 危险操作按钮 (Danger Button) -->
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.Danger}" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.DangerSoft}" />
    </Style>

    <!-- 侧栏导航胶囊按钮 (Sidebar Nav Button) -->
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.SidebarText}" />
      <Setter Property="Padding" Value="8,10" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Margin" Value="8,3" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.SidebarHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.SidebarTextHover}" />
    </Style>
    <Style Selector="Button.nav.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.SidebarActive}" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.SidebarTextActive}" />
    </Style>

    <!-- 条目列表卡片按钮 (Vault Entry Item Button) -->
    <Style Selector="Button.entry">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.Text}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Margin" Value="4,2" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.entry:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.SurfaceMuted}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.Border}" />
    </Style>
    <Style Selector="Button.entry.selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.Selection}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.SelectionBorder}" />
    </Style>

    <Style Selector="Border.kind-tile">
      <Setter Property="Background" Value="{DynamicResource Kp.BadgeBg}" />
    </Style>
    <Style Selector="Border.kind-tile.logo">
      <Setter Property="Background" Value="{DynamicResource Kp.LogoTile}" />
    </Style>

    <!-- 分类与账号卡片 -->
    <Style Selector="Button.filter-card, Button.account-card">
      <Setter Property="Background" Value="{DynamicResource Kp.Surface}" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.Text}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.filter-card:pointerover /template/ ContentPresenter, Button.account-card:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.SurfaceMuted}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.SelectionBorder}" />
    </Style>
    <Style Selector="Button.filter-card.selected /template/ ContentPresenter, Button.account-card.selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.Selection}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.Accent}" />
    </Style>
    <Style Selector="Border.count-badge">
      <Setter Property="Background" Value="{DynamicResource Kp.BadgeBg}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.count-badge > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Kp.BadgeFg}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.chip">
      <Setter Property="Background" Value="{DynamicResource Kp.Surface}" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.Text}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.chip:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.SurfaceMuted}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.SelectionBorder}" />
    </Style>
    <Style Selector="Button.chip.selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.AccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.Accent}" />
    </Style>

    <!-- 输入框基础样式 (TextBox) -->
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.Border}" />
      <Setter Property="Background" Value="{DynamicResource Kp.SurfaceMuted}" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.Text}" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox[AcceptsReturn=True]">
      <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <!-- 卡片内的无边框输入框：负外边距抵消内边距，未聚焦时文字与标题对齐 -->
    <Style Selector="TextBox.inline">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Margin" Value="-8,2,-8,0" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="LetterSpacing" Value="0" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.Border}" />
      <Setter Property="Background" Value="{DynamicResource Kp.SurfaceMuted}" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.Text}" />
      <Setter Property="Padding" Value="12,6,8,6" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="MaxDropDownHeight" Value="178" />
    </Style>
    <Style Selector="Border.field ComboBox">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="10,4,8,4" />
    </Style>
    <Style Selector="ComboBox:dropdownopen /template/ Border#Background">
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.Accent}" />
    </Style>
    <Style Selector="ComboBox /template/ Border#PopupBorder">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="BoxShadow" Value="0 6 16 0 #26000000" />
    </Style>
    <Style Selector="ComboBoxItem">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ComboBoxItem:selected">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="MenuFlyoutPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="MinWidth" Value="140" />
    </Style>
    <Style Selector="MenuFlyoutPresenter MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource Kp.Text}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="MenuFlyoutPresenter MenuItem /template/ Border#PART_LayoutRoot">
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="MenuFlyoutPresenter MenuItem:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource Kp.AccentSoft}" />
    </Style>
    <Style Selector="MenuFlyoutPresenter MenuItem:pointerover /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="Foreground" Value="{DynamicResource Kp.Accent}" />
    </Style>
    <Style Selector="MenuFlyoutPresenter MenuItem:pressed /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource Kp.BadgeBg}" />
    </Style>
    <Style Selector="MenuFlyoutPresenter Separator">
      <Setter Property="Background" Value="{DynamicResource Kp.Border}" />
      <Setter Property="Margin" Value="8,4" />
    </Style>
    <Style Selector="TextBox:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.Accent}" />
      <Setter Property="Background" Value="{DynamicResource Kp.Surface}" />
    </Style>
    <Style Selector="TextBox.mono">
      <Setter Property="FontFamily" Value="{StaticResource Kp.Font.Mono}" />
      <Setter Property="LetterSpacing" Value="0" />
    </Style>
    <Style Selector="TextBox.inline[AcceptsReturn=True]">
      <Setter Property="Padding" Value="8,5,8,2" />
      <Setter Property="Margin" Value="-8,-1,-8,0" />
    </Style>
    <!-- 中文字形贴着字框，多行文本的行尾光标会往左收约 1 像素压在字上；展示与编辑用同一字距，避免切换时文字跳动。 -->
    <Style Selector="TextBox.inline[AcceptsReturn=True]:not(.mono)">
      <Setter Property="LetterSpacing" Value="1" />
    </Style>

    <!-- 文本排版样式 (Typography) -->
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.Text}" />
      <Setter Property="LetterSpacing" Value="-0.3" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.Text}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource Kp.TextMuted}" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="TextBlock.field-label">
      <Setter Property="Foreground" Value="{DynamicResource Kp.TextMuted}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource Kp.TextMuted}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,10,0,6" />
    </Style>
    <Style Selector="TextBlock.domain">
      <Setter Property="Foreground" Value="{DynamicResource Kp.TextMuted}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="14,14,14,4" />
      <Setter Property="LetterSpacing" Value="0.6" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="{StaticResource Kp.Font.Mono}" />
    </Style>

    <!-- 容器与卡片样式 (Containers) -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource Kp.Surface}" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="BoxShadow" Value="0 16 36 0 #26000000" />
      <Setter Property="Padding" Value="28" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.Border}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource Kp.Surface}" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Border.field">
      <Setter Property="Background" Value="{DynamicResource Kp.SurfaceElevated}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="Border.audit-card">
      <Setter Property="Background" Value="{DynamicResource Kp.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16,12" />
    </Style>
    <Style Selector="TextBlock.danger">
      <Setter Property="Foreground" Value="{DynamicResource Kp.Danger}" />
    </Style>
    <Style Selector="TextBlock.success">
      <Setter Property="Foreground" Value="{DynamicResource Kp.Success}" />
    </Style>
    <Style Selector="TextBlock.warning">
      <Setter Property="Foreground" Value="{DynamicResource Kp.Warning}" />
    </Style>

    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Kp.Text}" />
    </Style>
  </Application.Styles>
</Application>
