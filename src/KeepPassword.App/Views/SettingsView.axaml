<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:KeepPassword.App.Views"
             xmlns:c="using:KeepPassword.App.Controls"
             x:Class="KeepPassword.App.Views.SettingsView"
             Background="Transparent">
  <UserControl.Styles>
    <Style Selector="Border.section">
      <Setter Property="Background" Value="{DynamicResource Kp.Glass}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="20,18" />
    </Style>
    <Style Selector="Border.section TextBlock.h2">
      <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- 空间/标签芯片：名称 + 使用数 + 常驻的改名 / 删除小图标，多个芯片换行排列。
         每个芯片的底色、文字色、描边由代码按名称从 8 色配色里取（Styles/LabelPaletteTheme.axaml），这里只定形状。 -->
    <Style Selector="Border.label-chip">
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="Padding" Value="12,0,4,0" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.label-chip.editing">
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.Accent}" />
    </Style>
    <!-- 使用数：与名称同色、半透明，弱一档但仍属于同一色系。 -->
    <Style Selector="Border.label-chip TextBlock.label-chip-count">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="Margin" Value="6,0,2,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.label-chip Button.label-chip-icon">
      <Setter Property="Width" Value="22" /><Setter Property="Height" Value="22" />
      <Setter Property="MinHeight" Value="0" /><Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="11" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <!-- 图标颜色跟随芯片色相；悬停只加深底色，不换成别的颜色。删除图标悬停变红。 -->
    <Style Selector="Border.label-chip Button.label-chip-icon:pointerover">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.label-chip Button.label-chip-icon:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Label.IconHover}" />
    </Style>
    <Style Selector="Border.label-chip Button.label-chip-icon.danger-icon:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.DangerSoft}" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.Danger}" />
    </Style>
    <Style Selector="Border.label-chip Button.label-chip-name">
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Cursor" Value="IBeam" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- 悬停名称：保持芯片色，只加下划线提示"可以点击改名"。 -->
    <Style Selector="Border.label-chip Button.label-chip-name:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.label-chip Button.label-chip-name:pointerover TextBlock">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
    <!-- 芯片内改名输入框与末尾的新增输入框：和芯片同高，覆盖全局 TextBox 的 40px 高度。 -->
    <Style Selector="TextBox.label-chip-input">
      <Setter Property="MinHeight" Value="0" /><Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="12,0" /><Setter Property="CornerRadius" Value="15" />
      <Setter Property="FontSize" Value="13" /><Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Width" Value="150" />
    </Style>
    <Style Selector="Border.label-chip TextBox.label-chip-input">
      <Setter Property="Height" Value="26" /><Setter Property="Padding" Value="4,0" />
      <Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="120" />
    </Style>
    <Style Selector="Border.label-chip TextBox.label-chip-input:focus /template/ Border#PART_BorderElement, Border.label-chip TextBox.label-chip-input:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
    </Style>
  </UserControl.Styles>

  <DockPanel Margin="28,24" MaxWidth="760" HorizontalAlignment="Center">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,18">
      <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource Kp.SurfaceMuted}" BorderBrush="{DynamicResource Kp.Border}" BorderThickness="1">
        <PathIcon Data="{StaticResource Icon.Settings}" Width="18" Height="18" Foreground="{DynamicResource Kp.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="设置" Classes="h1" FontSize="20" />
        <TextBlock Text="外观、分类标签、存储位置、密钥与备份。" Classes="muted" />
      </StackPanel>
    </StackPanel>

    <ScrollViewer x:Name="Scroller">
      <StackPanel Spacing="14" Margin="0,0,14,8">

        <!-- 软件更新 -->
        <Border Classes="section">
          <StackPanel>
            <TextBlock Text="软件更新" Classes="h2" Margin="0,0,0,4" />
            <TextBlock x:Name="UpdateVersionText" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock x:Name="UpdateStatus" Classes="muted" TextWrapping="Wrap" />
            <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="1" Height="6" Margin="0,10,0,0"
                         IsVisible="False" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
              <Button x:Name="UpdateCheckBtn" Classes="soft" Content="检查更新" Click="OnCheckUpdate" />
              <Button x:Name="UpdateDownloadBtn" Classes="accent" Content="下载更新" Click="OnDownloadUpdate"
                      IsVisible="False" />
              <Button x:Name="UpdateCancelBtn" Classes="ghost" Content="取消下载" Click="OnCancelDownload"
                      IsVisible="False" />
              <Button x:Name="UpdateInstallBtn" Classes="accent" Content="开始安装" Click="OnInstallUpdate"
                      IsVisible="False" />
              <Button x:Name="UpdateGitHubBtn" Classes="ghost" Content="打开 GitHub" Click="OnOpenGitHubReleases" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 浏览器扩展商店 -->
        <Border Classes="section">
          <StackPanel>
            <TextBlock Text="浏览器扩展" Classes="h2" Margin="0,0,0,4" />
            <TextBlock Text="网页自动填充请安装 Edge 扩展。若提示尚未连接，点「修复 Edge 扩展注册」，然后完全退出并重新打开 Edge。"
                       Classes="muted" TextWrapping="Wrap" Margin="0,0,0,12" />
            <TextBlock x:Name="BrowserExtensionStatus" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="accent" Content="修复 Edge 扩展注册" Click="OnRepairEdgeExtension" />
              <Button Classes="ghost" Content="打开 Edge 扩展商店" Click="OnOpenEdgeExtensionStore" />
            </StackPanel>
          </StackPanel>
        </Border>
        <!-- 外观与主题设置 -->
        <Border Classes="section">
          <StackPanel>
            <TextBlock Text="外观与色彩主题" Classes="h2" Margin="0,0,0,4" />
            <TextBlock Text="选择偏好的界面风格。" Classes="muted" Margin="0,0,0,12" />
            <!-- 0 浅色 / 1 深色 / 2 跟随系统 -->
            <c:SegmentedControl x:Name="ThemeSegments" AutomationProperties.Name="界面主题" SelectionChanged="OnThemeSegmentChanged">
              <ListBoxItem Content="浅色" />
              <ListBoxItem Content="深色" />
              <ListBoxItem Content="跟随系统" />
            </c:SegmentedControl>
          </StackPanel>
        </Border>

        <Border Classes="section">
          <StackPanel>
            <TextBlock Text="界面动画" Classes="h2" Margin="0,0,0,4" />
            <TextBlock Text="流畅动画提供平滑的展开和切换；也可以跟随系统设置或减少动画。"
                       Classes="muted" TextWrapping="Wrap" Margin="0,0,0,12" />
            <!-- 0 流畅动画 / 1 跟随系统 / 2 减少动画 -->
            <c:SegmentedControl x:Name="MotionSegments" AutomationProperties.Name="界面动画" SelectionChanged="OnMotionSegmentChanged">
              <ListBoxItem Content="流畅动画" />
              <ListBoxItem Content="跟随系统" />
              <ListBoxItem Content="减少动画" />
            </c:SegmentedControl>
            <TextBlock x:Name="MotionStatus" Classes="muted" TextWrapping="Wrap" Margin="0,10,0,0" />
          </StackPanel>
        </Border>

        <!-- 开机启动 -->
        <Border Classes="section">
          <StackPanel>
            <TextBlock Text="开机启动" Classes="h2" Margin="0,0,0,4" />
            <TextBlock Text="登录系统后自动运行 Keep Password。最小化启动时会先进入托盘，不弹出主窗口。"
                       Classes="muted" TextWrapping="Wrap" Margin="0,0,0,12" />
            <!-- 两个开关并排：左边是否开机启动，右边启动方式（未开启开机启动时右侧禁用）。 -->
            <WrapPanel Orientation="Horizontal" ItemSpacing="32" LineSpacing="10">
              <ToggleSwitch x:Name="LaunchAtStartupSwitch" OffContent="关闭" OnContent="开机启动" AutomationProperties.Name="开机启动"
                            IsCheckedChanged="OnLaunchAtStartupChanged" />
              <ToggleSwitch x:Name="StartMinimizedSwitch" OffContent="正常窗口" OnContent="最小化启动" AutomationProperties.Name="最小化启动"
                            IsCheckedChanged="OnStartMinimizedChanged" />
            </WrapPanel>
            <TextBlock x:Name="StartupStatus" Classes="muted" TextWrapping="Wrap" Margin="0,10,0,0" />
          </StackPanel>
        </Border>

        <!-- 程序自动填充快捷键 -->
        <Border x:Name="HotkeySection" Classes="section">
          <StackPanel>
            <TextBlock Text="程序自动填充快捷键" Classes="h2" Margin="0,0,0,4" />
            <TextBlock x:Name="HotkeyHint"
                       Text="Windows：点击密码框后按快捷键填入，不会因检测到密码框自动弹窗。macOS：点击密码框会自动提示选账号，也可按快捷键；需在「系统设置 → 隐私与安全性 → 辅助功能」中允许 Keep Password。浏览器网页请使用浏览器扩展。"
                       Classes="muted" TextWrapping="Wrap" Margin="0,0,0,12" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox x:Name="HotkeyBox" Classes="mono" IsReadOnly="True"
                       Watermark="点击后按下新的组合键"
                       GotFocus="OnHotkeyFocus" LostFocus="OnHotkeyBlur" KeyDown="OnHotkeyKeyDown" />
              <Button Grid.Column="1" Classes="soft" Content="恢复默认" Click="OnHotkeyReset" />
            </Grid>
            <TextBlock x:Name="HotkeyStatus" Classes="muted" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <!-- 空间分类与账号标签 -->
        <Border Classes="section">
          <StackPanel>
            <TextBlock Text="空间分类与账号标签" Classes="h2" Margin="0,0,0,4" />
            <TextBlock Text="点名称或铅笔可直接改名（回车保存、Esc 取消），改成已有名称会合并；× 删除。在末尾输入框里回车即可新增。"
                       TextWrapping="Wrap" Classes="muted" Margin="0,0,0,8" />
            <!-- 芯片式列表：每项一行改成一个小芯片，多项自动换行，整段高度大约只有原来的 1/5。
                 新增输入框由代码放在每个列表的最后一个位置。 -->
            <TextBlock Text="空间分类" Classes="label" />
            <WrapPanel x:Name="SpaceList" ItemSpacing="6" LineSpacing="6">
              <TextBox x:Name="NewSpaceBox" Classes="label-chip-input" Watermark="+ 新增空间" KeyDown="OnAddSpaceKeyDown"
                       AutomationProperties.Name="新增空间分类" />
            </WrapPanel>
            <TextBlock Text="账号标签" Classes="label" Margin="0,16,0,6" />
            <WrapPanel x:Name="TagList" ItemSpacing="6" LineSpacing="6">
              <TextBox x:Name="NewTagBox" Classes="label-chip-input" Watermark="+ 新增标签" KeyDown="OnAddTagKeyDown"
                       AutomationProperties.Name="新增账号标签" />
            </WrapPanel>
            <TextBlock x:Name="LabelStatus" Classes="muted" TextWrapping="Wrap" Margin="0,6,0,0" />
          </StackPanel>
        </Border>

        <!-- 缓存目录 -->
        <Border Classes="section">
          <StackPanel>
            <TextBlock Text="缓存目录" Classes="h2" Margin="0,0,0,4" />
            <TextBlock Text="切换后会把当前目录里的所有保险库文件迁移到新目录，然后清理原目录。"
                       TextWrapping="Wrap" Classes="muted" Margin="0,0,0,8" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox x:Name="DirectoryBox" Classes="mono" />
              <Button Grid.Column="1" Classes="soft" Content="浏览…" Click="OnBrowseDirectory" />
            </Grid>
            <Button Classes="ghost" Content="迁移并切换到此目录" Margin="0,6,0,0" HorizontalAlignment="Left" Click="OnSwitchDirectory" />
            <TextBlock x:Name="DirectoryStatus" Classes="muted" TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>
        </Border>

        <!-- 修改短密钥 -->
        <Border Classes="section">
          <StackPanel>
            <TextBlock Text="修改短密钥" Classes="h2" Margin="0,0,0,4" />
            <TextBlock x:Name="ShortKeyHint" Text="提交前必须验证当前短密钥。自动填入时仍会再确认一次。"
                       TextWrapping="Wrap" Classes="muted" Margin="0,0,0,8" />
            <TextBlock x:Name="AccountText" Classes="muted" Margin="0,0,0,4" FontWeight="SemiBold" />
            <!-- 顺序：当前短密钥（或主密码）→ 新短密钥 → 确认新短密钥；Tab 键也按这个顺序走。 -->
            <TextBlock x:Name="VerifyLabel" Text="当前短密钥" Classes="label" />
            <TextBox x:Name="MasterBox" views:AsciiInput.IsEnabled="True" PasswordChar="•" views:PasswordReveal.IsEnabled="True" Classes="mono" FontSize="15" />
            <TextBlock Text="新短密钥" Classes="label" />
            <TextBox x:Name="NewKeyBox" views:AsciiInput.IsEnabled="True" PasswordChar="•" views:PasswordReveal.IsEnabled="True" Classes="mono" FontSize="15" />
            <TextBlock Text="确认新短密钥" Classes="label" />
            <TextBox x:Name="ConfirmBox" views:AsciiInput.IsEnabled="True" PasswordChar="•" views:PasswordReveal.IsEnabled="True" Classes="mono" FontSize="15" />
            <Border Background="{DynamicResource Kp.DangerSoft}" BorderBrush="{DynamicResource Kp.Danger}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,10,0,0" IsVisible="False" x:Name="ErrorBox" views:Motion.RevealOnShow="True">
              <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Kp.Danger}" TextWrapping="Wrap" />
            </Border>
            <TextBlock x:Name="BusyText" Text="正在验证…" Classes="muted" Margin="0,8,0,0" IsVisible="False" views:Motion.RevealOnShow="True" />
            <TextBlock x:Name="KeyStatus" Classes="muted" Margin="0,8,0,0" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
              <Button Classes="ghost" Content="清空" Click="OnCancel" />
              <Button x:Name="SaveButton" Classes="accent" Content="保存短密钥" Click="OnSave" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 更换主密码（仅 v1/v2） -->
        <Border x:Name="MasterPasswordSection" Classes="section">
          <StackPanel>
            <TextBlock Text="更换主密码" Classes="h2" Margin="0,0,0,4" />
            <TextBlock x:Name="MasterChangeHint" Text="更换主密码不会改变加密密钥，之前保存的密钥文件仍然有效。" TextWrapping="Wrap" Classes="muted" Margin="0,0,0,8" />
            <TextBlock Text="当前主密码" Classes="label" />
            <TextBox x:Name="CurrentMasterBox" views:AsciiInput.IsEnabled="True" PasswordChar="•" views:PasswordReveal.IsEnabled="True" Classes="mono" FontSize="15" />
            <TextBlock Text="新主密码" Classes="label" />
            <TextBox x:Name="NewMasterBox" views:AsciiInput.IsEnabled="True" PasswordChar="•" views:PasswordReveal.IsEnabled="True" Classes="mono" FontSize="15" />
            <TextBlock Text="确认新主密码" Classes="label" />
            <TextBox x:Name="ConfirmMasterBox" views:AsciiInput.IsEnabled="True" PasswordChar="•" views:PasswordReveal.IsEnabled="True" Classes="mono" FontSize="15" />
            <Button Classes="accent" Content="更换主密码" HorizontalAlignment="Right" Margin="0,12,0,0" Click="OnChangeMaster" />
          </StackPanel>
        </Border>

        <Border Classes="section">
          <StackPanel Spacing="8">
            <TextBlock Text="加密密钥" Classes="h2" />
            <TextBlock x:Name="EncryptionKeyStatus" TextWrapping="Wrap" Classes="muted" />
            <Button x:Name="SavePendingKeyButton" Classes="soft" Content="保存加密密钥文件…" HorizontalAlignment="Left" Click="OnSavePendingKey" />
            <Button x:Name="UpgradeLocalKeyButton" Classes="soft" Content="升级到本地密钥格式…" HorizontalAlignment="Left" Click="OnUpgradeLocalKey" IsVisible="False" />
          </StackPanel>
        </Border>

        <!-- 云同步 -->
        <Border Classes="section">
          <StackPanel Spacing="8">
            <TextBlock Text="云同步" Classes="h2" Margin="0,0,0,0" />
            <TextBlock Text="使用已在官网完成邮箱验证的账号同步加密保险库。请保管官网验证时下载的 .kpbind。服务器只保存密文，不能解密。这里的验证码是开启同步时单独发送的 8 位字母数字，不能用注册验证码或 6 位重置码。"
                       TextWrapping="Wrap" Classes="muted" />
            <TextBlock x:Name="SyncStatusText" Classes="muted" TextWrapping="Wrap" />

            <StackPanel x:Name="SyncBoundPanel" IsVisible="False" Spacing="8">
              <TextBlock x:Name="SyncAccountText" FontWeight="SemiBold" />
              <TextBlock x:Name="SyncMetaText" Classes="muted" TextWrapping="Wrap" />
              <TextBlock Text="更换云端密钥会读取一份新的 .kpkey。它是数据密钥，不是 .kpbind，也不是网站密码。只有当前密钥能解开云端数据时才会合并并提交；解密失败不会被当成空库。"
                         TextWrapping="Wrap" Classes="muted" />
              <TextBox x:Name="SyncRotatePasswordBox" PasswordChar="•" Watermark="换钥时填写网站密码，只在本机包裹新密钥，不保存" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="accent" Content="立即刷新" Click="OnSyncRefresh" />
                <Button x:Name="SyncRotateButton" Classes="soft" Content="更换云端密钥…" Click="OnSyncRotateKey" />
                <Button x:Name="SyncAdoptButton" Classes="soft" Content="用密钥文件恢复同步…" IsVisible="False" Click="OnSyncAdoptKey" />
                <Button Classes="danger" Content="断开云同步" Click="OnSyncDisconnect" />
              </StackPanel>
            </StackPanel>

            <StackPanel x:Name="SyncBindPanel" Spacing="6">
              <TextBlock Text="官网邮箱" Classes="label" />
              <TextBox x:Name="SyncEmailBox" Watermark="you@example.com" />
              <TextBlock Text="官网密码" Classes="label" />
              <TextBox x:Name="SyncPasswordBox" PasswordChar="•" views:PasswordReveal.IsEnabled="True" Classes="mono" />
              <TextBlock Text="绑定密钥" Classes="label" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="SyncBindingKeyBox" PasswordChar="•" views:PasswordReveal.IsEnabled="True" Watermark="粘贴或选择 .kpbind" Classes="mono" />
                <Button Grid.Column="1" Classes="soft" Content="选择…" Click="OnPickBindingKey" />
              </Grid>
              <TextBlock Text="邮箱验证码" Classes="label" />
              <TextBlock Text="8 位字母数字，15 分钟内有效。连续错误 5 次后失效。重新发送会使上一封失效。"
                         TextWrapping="Wrap" Classes="muted" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="SyncCodeBox" Watermark="8 位字母数字" Classes="mono" MaxLength="8" />
                <Button Grid.Column="1" Classes="soft" Content="发送验证码" Click="OnSyncSendCode" />
              </Grid>
              <Button Classes="accent" Content="绑定并开启同步" HorizontalAlignment="Left" Margin="0,6,0,0" Click="OnSyncBind" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 加密备份 -->
        <Border Classes="section">
          <StackPanel>
            <TextBlock Text="加密备份与还原" Classes="h2" Margin="0,0,0,4" />
            <TextBlock Text="备份经过加密。还原时需要该备份对应的加密密钥文件或完整密钥，更换主密码不影响密钥。"
                       TextWrapping="Wrap" Classes="muted" Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Classes="soft" Click="OnExport">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource Icon.Vault}" Width="14" Height="14" />
                  <TextBlock Text="导出加密备份" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="soft" Click="OnImport">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource Icon.Refresh}" Width="14" Height="14" />
                  <TextBlock Text="从备份还原…" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="section">
          <StackPanel>
            <TextBlock Text="明文 CSV" Classes="h2" Margin="0,0,0,4" />
            <TextBlock Text="导出前会验证加密密钥。文件包含明文密码、验证码密钥和私钥，请自行保管。导入会把 CSV 里的行追加为新条目，不会替换现有条目。"
                       TextWrapping="Wrap" Classes="muted" Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Classes="soft" Click="OnExportCsv">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource Icon.Copy}" Width="14" Height="14" />
                  <TextBlock Text="导出 CSV" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="soft" Click="OnImportCsv">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource Icon.Refresh}" Width="14" Height="14" />
                  <TextBlock Text="导入 CSV" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="UndoImportButton" Classes="soft" Click="OnUndoCsvImport" IsVisible="False" Content="撤销导入" />
            </StackPanel>
            <TextBlock x:Name="CsvStatus" Classes="muted" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
