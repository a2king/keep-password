<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KeepPassword.App.Views.PasswordGeneratorView"
             Background="Transparent">
  <UserControl.Styles>
    <Style Selector="Button.segment">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.TextMuted}" />
      <Setter Property="Padding" Value="8,8" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.segment /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.segment.selected">
      <Setter Property="Foreground" Value="{DynamicResource Kp.Text}" />
    </Style>
    <Style Selector="Button.segment.selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.Surface}" />
      <Setter Property="BoxShadow" Value="0 2 6 0 #18000000" />
    </Style>
    <Style Selector="ToggleSwitch">
      <Setter Property="OnContent" Value="" />
      <Setter Property="OffContent" Value="" />
      <Setter Property="MinWidth" Value="44" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer x:Name="Host" HorizontalScrollBarVisibility="Disabled">
    <Panel MinHeight="{Binding Bounds.Height, ElementName=Host}">
      <Border x:Name="Card" Classes="card" Margin="32" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="密码生成器" Classes="h1" FontSize="22" Margin="0,0,0,4" />
          <TextBlock Text="生成高熵、不可预测的强密码，保护您的数字资产。" Classes="muted" Margin="0,0,0,18" />

          <TextBlock Text="选择密码类型" Classes="label" />
          <Border Background="{DynamicResource Kp.SurfaceMuted}" BorderBrush="{DynamicResource Kp.Border}" BorderThickness="1" CornerRadius="10" Padding="4">
            <Grid ColumnDefinitions="*,*,*">
              <Button x:Name="RandomButton" Classes="segment selected" Content="随机字符" Click="OnRandom" />
              <Button x:Name="MemorableButton" Grid.Column="1" Classes="segment" Content="容易记住" Click="OnMemorable" Margin="4,0" />
              <Button x:Name="PinButton" Grid.Column="2" Classes="segment" Content="# PIN 纯数字" Click="OnPin" />
            </Grid>
          </Border>

          <TextBlock Text="自定义参数" Classes="label" Margin="0,20,0,6" />
          <Border Height="1" Background="{DynamicResource Kp.Border}" />

          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,8">
            <TextBlock Text="密码长度" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="Medium" />
            <Slider x:Name="LengthSlider" Grid.Column="1" Minimum="8" Maximum="64" Value="16" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
            <Border Grid.Column="2" MinWidth="52" Height="34" Margin="12,0,0,0" CornerRadius="8" BorderBrush="{DynamicResource Kp.Border}" BorderThickness="1" Background="{DynamicResource Kp.SurfaceMuted}">
              <TextBlock x:Name="LengthValue" Text="16" Classes="mono" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13.5" />
            </Border>
          </Grid>

          <Grid Height="44" Margin="0,6,0,4">
            <StackPanel x:Name="RandomOptions" Orientation="Horizontal" Spacing="28" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="包含数字" VerticalAlignment="Center" />
                <ToggleSwitch x:Name="DigitSwitch" IsChecked="True" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="包含特殊符号" VerticalAlignment="Center" />
                <ToggleSwitch x:Name="SymbolSwitch" IsChecked="False" />
              </StackPanel>
            </StackPanel>
            <StackPanel x:Name="MemorableOptions" Orientation="Horizontal" Spacing="28" VerticalAlignment="Center" IsVisible="False">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="首字母大写" VerticalAlignment="Center" />
                <ToggleSwitch x:Name="CapitalSwitch" IsChecked="False" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="使用完整单词" VerticalAlignment="Center" />
                <ToggleSwitch x:Name="FullWordSwitch" IsChecked="True" />
              </StackPanel>
            </StackPanel>
          </Grid>

          <Border Height="1" Background="{DynamicResource Kp.Border}" Margin="0,12,0,0" />

          <TextBlock Text="生成结果" Classes="label" Margin="0,16,0,8" />
          <Border x:Name="ResultBox"
                  MinHeight="72"
                  Background="{DynamicResource Kp.SurfaceMuted}"
                  BorderBrush="{DynamicResource Kp.Border}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="16,12">
            <SelectableTextBlock x:Name="ResultText"
                                 Classes="mono"
                                 FontSize="22"
                                 FontWeight="Bold"
                                 LetterSpacing="2"
                                 Foreground="{DynamicResource Kp.Accent}"
                                 TextAlignment="Center"
                                 TextWrapping="Wrap"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Center" />
          </Border>
          <TextBlock x:Name="CopyStatus" Classes="muted" Height="18" Margin="0,8,0,0" HorizontalAlignment="Center" />

          <Grid ColumnDefinitions="*,12,*" Margin="0,12,0,0">
            <Button Classes="accent" Click="OnCopy">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Copy}" Width="15" Height="15" />
                <TextBlock Text="复制密码" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Grid.Column="2" Classes="outline" Click="OnRefresh">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Refresh}" Width="15" Height="15" />
                <TextBlock Text="重新生成" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </Panel>
  </ScrollViewer>
</UserControl>
