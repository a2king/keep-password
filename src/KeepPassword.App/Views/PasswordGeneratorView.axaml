<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:KeepPassword.App.Views"
             xmlns:c="using:KeepPassword.App.Controls"
             x:Class="KeepPassword.App.Views.PasswordGeneratorView"
             Background="Transparent">
  <UserControl.Styles>
    <Style Selector="Border.generator-result">
      <Setter Property="Transitions">
        <Transitions><BrushTransition Property="BorderBrush" Duration="0:0:0.14" Easing="CubicEaseOut" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.generator-result:pointerover, Border.generator-result:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource Kp.Accent}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer x:Name="Host" HorizontalScrollBarVisibility="Disabled">
    <Panel MinHeight="{Binding Bounds.Height, ElementName=Host}">
      <Border x:Name="Card" Classes="card" Margin="32" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="密码生成器" Classes="h1" FontSize="22" Margin="0,0,0,4" />
          <TextBlock Text="生成高熵、不可预测的强密码，保护您的数字资产。" Classes="muted" Margin="0,0,0,18" />

          <TextBlock Text="选择密码类型" Classes="label" />
          <!-- 顺序与 PasswordGeneratorKind 对应：0 随机字符 / 1 容易记住 / 2 PIN。 -->
          <c:SegmentedControl x:Name="KindSegments" AutomationProperties.Name="选择密码类型" SelectionChanged="OnKindChanged">
            <ListBoxItem Content="随机字符" />
            <ListBoxItem Content="容易记住" />
            <ListBoxItem Content="# PIN 纯数字" />
          </c:SegmentedControl>

          <TextBlock Text="自定义参数" Classes="label" Margin="0,20,0,6" />
          <Border Height="1" Background="{DynamicResource Kp.Border}" />

          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,8">
            <TextBlock Text="密码长度" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="Medium" />
            <Slider x:Name="LengthSlider" Grid.Column="1" Minimum="8" Maximum="64" Value="16" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
            <Border Grid.Column="2" MinWidth="52" Height="34" Margin="12,0,0,0" CornerRadius="8" BorderBrush="{DynamicResource Kp.Border}" BorderThickness="1" Background="{DynamicResource Kp.SurfaceMuted}">
              <TextBlock x:Name="LengthValue" Text="16" Classes="mono" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13.5" />
            </Border>
          </Grid>

          <Grid Height="44" Margin="0,6,0,4">
            <StackPanel x:Name="RandomOptions" Orientation="Horizontal" Spacing="28" VerticalAlignment="Center" views:Motion.RevealOnShow="True">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="包含数字" VerticalAlignment="Center" />
                <ToggleSwitch x:Name="DigitSwitch" IsChecked="True" AutomationProperties.Name="包含数字" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="包含特殊符号" VerticalAlignment="Center" />
                <ToggleSwitch x:Name="SymbolSwitch" IsChecked="False" AutomationProperties.Name="包含特殊符号" />
              </StackPanel>
            </StackPanel>
            <StackPanel x:Name="MemorableOptions" Orientation="Horizontal" Spacing="28" VerticalAlignment="Center" IsVisible="False" views:Motion.RevealOnShow="True">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="首字母大写" VerticalAlignment="Center" />
                <ToggleSwitch x:Name="CapitalSwitch" IsChecked="False" AutomationProperties.Name="首字母大写" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="使用完整单词" VerticalAlignment="Center" />
                <ToggleSwitch x:Name="FullWordSwitch" IsChecked="True" AutomationProperties.Name="使用完整单词" />
              </StackPanel>
            </StackPanel>
          </Grid>

          <Border Height="1" Background="{DynamicResource Kp.Border}" Margin="0,12,0,0" />

          <TextBlock Text="生成结果" Classes="label" Margin="0,16,0,8" />
          <!-- 白底结果框：点击或键盘 Enter/Space 直接复制，与"复制密码"按钮走同一逻辑。
               用普通 TextBlock 而非 SelectableTextBlock，否则点击会被文字选择吞掉。 -->
          <Border x:Name="ResultBox"
                  Classes="generator-result"
                  MinHeight="72"
                  Background="{DynamicResource Kp.Surface}"
                  BorderBrush="{DynamicResource Kp.Border}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="16,12"
                  Cursor="Hand"
                  Focusable="True"
                  ToolTip.Tip="点击复制密码"
                  AutomationProperties.Name="生成的密码，点击复制"
                  Tapped="OnResultTapped"
                  KeyDown="OnResultKeyDown">
            <TextBlock x:Name="ResultText"
                                 Classes="mono"
                                 FontSize="22"
                                 FontWeight="Bold"
                                 LetterSpacing="2"
                                 Foreground="{DynamicResource Kp.Accent}"
                                 TextAlignment="Center"
                                 TextWrapping="Wrap"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Center" />
          </Border>
          <TextBlock x:Name="CopyStatus" Classes="muted" Height="18" Margin="0,8,0,0" HorizontalAlignment="Center" />

          <Grid ColumnDefinitions="*,12,*" Margin="0,12,0,0">
            <Button Classes="outline" HorizontalAlignment="Left" Click="OnRefresh">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Refresh}" Width="15" Height="15" />
                <TextBlock Text="重新生成" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="CopyButton" Grid.Column="2" Classes="accent" HorizontalAlignment="Right" Click="OnCopy">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Copy}" Width="15" Height="15" />
                <TextBlock Text="复制密码" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </Panel>
  </ScrollViewer>
</UserControl>
