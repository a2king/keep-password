<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:KeepPassword.App.Views"
             xmlns:vm="using:KeepPassword.App.ViewModels"
             x:Class="KeepPassword.App.Views.TotpView"
             x:DataType="vm:TotpPageViewModel"
             Background="Transparent">
  <UserControl.Styles>
    <Style Selector="Button.totp-code">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.Accent}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,2" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.totp-code /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.totp-code:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.AccentSoft}" />
    </Style>
    <Style Selector="Button.totp-code:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.Selection}" />
    </Style>
    <Style Selector="Button.totp-code.copy-success /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Kp.AccentSoft}" />
      <Setter Property="Foreground" Value="{DynamicResource Kp.Accent}" />
    </Style>
    <!-- 倒计时圆环：与条目详情的验证码一致（灰色轨道 + 蓝色剩余圆弧 + 中心秒数），最后 5 秒变警示色。
         每秒只改一次圆弧角度和数字，没有常驻动画。 -->
    <Style Selector="Panel.totp-ring Arc">
      <Setter Property="Stroke" Value="{DynamicResource Detail.Accent}" />
    </Style>
    <Style Selector="Panel.totp-ring.urgent Arc">
      <Setter Property="Stroke" Value="{DynamicResource Detail.Warning}" />
    </Style>
    <Style Selector="Panel.totp-ring TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Detail.TextMuted}" />
    </Style>
    <Style Selector="Panel.totp-ring.urgent TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Detail.WarningText}" />
    </Style>
  </UserControl.Styles>
  <DockPanel Margin="28,24" MaxWidth="760" HorizontalAlignment="Center">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,18">
      <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource Kp.SurfaceMuted}" BorderBrush="{DynamicResource Kp.Border}" BorderThickness="1">
        <PathIcon Data="{StaticResource Icon.Totp}" Width="18" Height="18" Foreground="{DynamicResource Kp.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="两步验证码 (TOTP)" Classes="h1" FontSize="20" />
        <TextBlock Text="点击数字即可复制。圆环显示本轮验证码的剩余时间。" Classes="muted" />
        <TextBlock x:Name="CopyStatus" Classes="muted" IsVisible="False" />
      </StackPanel>
    </StackPanel>

    <TextBlock DockPanel.Dock="Top" Text="当前保险库中还没有包含验证码密钥的条目。" IsVisible="{Binding IsEmpty}" Classes="muted" Margin="0,16,0,0" HorizontalAlignment="Center" views:Motion.RevealOnShow="True" />

    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TotpRowView">
            <Border Background="{DynamicResource Kp.Surface}" CornerRadius="12" Padding="16,14" Margin="0,0,0,10" BorderBrush="{DynamicResource Kp.Border}" BorderThickness="1">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1"
                        Classes="totp-code"
                        ToolTip.Tip="点击复制"
                        Click="OnCopy"
                        Tag="{Binding Code}"
                        VerticalAlignment="Center"
                        Margin="12,0">
                  <TextBlock Text="{Binding Code}"
                             Classes="mono"
                             FontSize="28"
                             FontWeight="Bold"
                             LetterSpacing="2.5"
                             Foreground="{DynamicResource Kp.Accent}" />
                </Button>
                <Panel Grid.Column="2" Classes="totp-ring" Classes.urgent="{Binding IsUrgent}" IsVisible="{Binding HasCountdown}"
                       Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Center"
                       ToolTip.Tip="{Binding Remaining, StringFormat='{}{0} 秒后刷新'}">
                  <Ellipse Stroke="{DynamicResource Detail.Divider}" StrokeThickness="3" />
                  <Arc StartAngle="-90" SweepAngle="{Binding RemainingSweep}" StrokeThickness="3" StrokeLineCap="Round" />
                  <TextBlock Text="{Binding Remaining}" Classes="mono" FontSize="11" FontWeight="SemiBold"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Panel>
                <Button Grid.Column="3" Classes="icon" Width="34" Height="34" ToolTip.Tip="复制验证码" Click="OnCopy" Tag="{Binding Code}" VerticalAlignment="Center">
                  <PathIcon Data="{StaticResource Icon.Copy}" Width="17" Height="17" />
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
