<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KeepPassword.App.ViewModels"
        xmlns:views="using:KeepPassword.App.Views"
        xmlns:vault="using:KeepPassword.Core.Vault"
        x:Class="KeepPassword.App.Views.MainWindow"
        Title="Keep Password"
        Width="1360"
        Height="800"
        MinWidth="1040"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Kp.Bg}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="32"
        Padding="{Binding $self.OffScreenMargin}"
        Icon="/Assets/app.ico">
  <Window.Resources>
    <DataTemplate x:Key="FieldBody" x:DataType="vm:FieldEditorView">
      <StackPanel>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding Label}" Classes="field-label" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
            <Button Classes="icon" ToolTip.Tip="生成密码" IsVisible="{Binding CanGenerate}" Tag="{Binding}" Click="OnGenerateField">
              <PathIcon Data="{StaticResource Icon.Generator}" />
            </Button>
            <Button Classes="icon" ToolTip.Tip="{Binding RevealText}" IsVisible="{Binding CanReveal}" Tag="{Binding}" Click="OnRevealField">
              <Panel>
                <PathIcon Data="{StaticResource Icon.Eye}" IsVisible="{Binding !Revealed}" />
                <PathIcon Data="{StaticResource Icon.EyeOff}" IsVisible="{Binding Revealed}" />
              </Panel>
            </Button>
            <Button Classes="icon" ToolTip.Tip="复制" Tag="{Binding}" Click="OnCopyField">
              <PathIcon Data="{StaticResource Icon.Copy}" />
            </Button>
          </StackPanel>
        </Grid>
        <TextBox Text="{Binding Value}"
                 PasswordChar="{Binding MaskChar}"
                 Watermark="{Binding Placeholder}"
                 AcceptsReturn="{Binding Multiline}"
                 TextWrapping="{Binding Wrapping}"
                 IsVisible="{Binding ShowEditor}"
                 Classes="inline"
                 Classes.mono="{Binding UseMono}"
                 MaxHeight="220" />
        <TextBlock Text="{Binding MaskedText}" IsVisible="{Binding ShowMasked}" Classes="muted" Margin="0,6,0,0" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>
  <Panel>
  <Grid x:Name="VaultRoot" x:DataType="vm:MainViewModel" ColumnDefinitions="88,*" IsVisible="False">
    <!-- 左侧极客现代导航侧栏 -->
    <Border Background="{DynamicResource Kp.Sidebar}" BorderBrush="{DynamicResource Kp.Border}" BorderThickness="0,0,1,0">
      <DockPanel Margin="0,24,0,12">
        <StackPanel DockPanel.Dock="Top" Spacing="6">
          <Image Source="/Assets/logo.png" Width="40" Height="40" HorizontalAlignment="Center" Margin="0,4,0,12" />
          <Button x:Name="NavItems" Classes="nav active" Click="OnNavItems" ToolTip.Tip="保险库条目">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource Icon.Vault}" Width="20" Height="20" />
              <TextBlock Text="条目" FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="NavGenerator" Classes="nav" Click="OnNavGenerator" ToolTip.Tip="密码生成器">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource Icon.Generator}" Width="20" Height="20" />
              <TextBlock Text="生成器" FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="NavTotp" Classes="nav" Click="OnTotp" ToolTip.Tip="双重验证码 (TOTP)">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource Icon.Totp}" Width="20" Height="20" />
              <TextBlock Text="验证码" FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="NavAudit" Classes="nav" Click="OnAudit" ToolTip.Tip="密码安全审计">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource Icon.Audit}" Width="20" Height="20" />
              <TextBlock Text="审计" FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="NavBreach" Classes="nav" Click="OnBreach" ToolTip.Tip="公开泄露检查">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource Icon.Breach}" Width="20" Height="20" />
              <TextBlock Text="泄露" FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="NavSettings" Classes="nav" Click="OnUsers" ToolTip.Tip="账户与偏好设置">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource Icon.Settings}" Width="20" Height="20" />
              <TextBlock Text="设置" FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- 侧栏底部：主题切换 + 锁定 -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="4" VerticalAlignment="Bottom">
          <Button x:Name="ThemeToggleButton" Classes="nav" Click="OnCycleTheme" ToolTip.Tip="点击切换：浅色 / 深色 / 跟随系统">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource Icon.Theme}" Width="19" Height="19" />
              <TextBlock x:Name="ThemeLabel" Text="主题" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes="nav" Click="OnLock" ToolTip.Tip="锁定保险库">
            <StackPanel Spacing="3" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource Icon.Lock}" Width="19" Height="19" />
              <TextBlock Text="锁定" FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding Account}" FontSize="10" Opacity="0.65" TextTrimming="CharacterEllipsis" MaxWidth="68" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <Border />
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid x:Name="ItemsPage" ColumnDefinitions="*,Auto">
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="20,44,20,12">
          <!-- 顶部：搜索 + 操作 + 空间下拉 -->
          <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,14">
            <Grid ColumnDefinitions="Auto,*">
              <TextBox Grid.ColumnSpan="2" Text="{Binding Search}" Watermark="搜索名称、标签、账号、备注、网址、主机、节点" Padding="34,8,12,8" />
              <PathIcon Data="{StaticResource Icon.Search}" Width="15" Height="15" Foreground="{DynamicResource Kp.TextMuted}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0">
              <Button Classes="soft" Content="导入 CSV" Click="OnImport" />
              <Button Classes="soft" Content="{Binding UndoImportText}" IsVisible="{Binding CanUndoImport}" Click="OnUndoImport" />
              <Button Classes="accent" Content="+ 新建">
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedRight">
                    <MenuItem Header="登录" Tag="login" Click="OnNewItem" />
                    <MenuItem Header="服务器" Tag="server" Click="OnNewItem" />
                    <MenuItem Header="数据库" Tag="database" Click="OnNewItem" />
                    <MenuItem Header="SSH 密钥" Tag="sshKey" Click="OnNewItem" />
                    <MenuItem Header="API 凭据" Tag="api" Click="OnNewItem" />
                    <MenuItem Header="集群服务" Tag="cluster" Click="OnNewItem" />
                    <Separator />
                    <MenuItem Header="独立验证码" Click="OnNewTotp" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
            <ComboBox Grid.Column="2"
                      Width="210"
                      Margin="10,0,0,0"
                      VerticalAlignment="Stretch"
                      ItemsSource="{Binding SpaceFilters}"
                      SelectedItem="{Binding SelectedSpaceFilter}"
                      ToolTip.Tip="选择空间分类">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:FilterItemView">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="1" Classes="count-badge" Margin="8,0,0,0">
                      <TextBlock Text="{Binding Count}" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>

          <!-- 类型卡片 -->
          <ItemsControl Grid.Row="1" ItemsSource="{Binding KindFilters}" Margin="0,0,0,6">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FilterItemView">
                <Button Classes="filter-card" Classes.selected="{Binding IsSelected}" Tag="{Binding Key}" Click="OnKindFilter" Width="132" Margin="0,0,8,8">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <PathIcon Data="{StaticResource Icon.Star}" Width="14" Height="14" Foreground="{DynamicResource Kp.Star}" IsVisible="{Binding IsFavorite}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="1" Classes="count-badge" Margin="8,0,0,0">
                      <TextBlock Text="{Binding Count}" />
                    </Border>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- 标签卡片 -->
          <TextBlock Grid.Row="2" Text="标签" Classes="label" Margin="2,0,0,8" />
          <ScrollViewer Grid.Row="3" MaxHeight="128" Margin="0,0,0,10">
            <ItemsControl ItemsSource="{Binding TagFilters}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FilterItemView">
                  <Button Classes="filter-card" Classes.selected="{Binding IsSelected}" Tag="{Binding Key}" Click="OnTagFilter" Width="168" Margin="0,0,8,8">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <Border Grid.Column="1" Classes="count-badge" Margin="8,0,0,0">
                        <TextBlock Text="{Binding Count}" />
                      </Border>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- 账号卡片 -->
          <Grid Grid.Row="4" RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto" Margin="2,0,2,8">
              <TextBlock Text="条目" Classes="label" Margin="0" />
              <TextBlock Grid.Column="1" Text="{Binding EntryCountText}" Classes="muted" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Grid.Row="1"
                       Text="{Binding EmptyText}"
                       IsVisible="{Binding ShowEmpty}"
                       Classes="muted"
                       TextWrapping="Wrap"
                       Margin="4,12" />
            <ScrollViewer x:Name="AccountScroller" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding EntryRows}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:EntryRowView">
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="{Binding Columns}" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EntryItemView">
                          <Button Classes="account-card" Classes.selected="{Binding IsSelected}" Tag="{Binding Id}" Click="OnEntry" Margin="0,0,10,10">
                            <Grid ColumnDefinitions="44,*">
                              <Border Classes="kind-tile" Classes.logo="{Binding HasLogo}" Width="36" Height="36" CornerRadius="10" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Panel>
                                  <TextBlock Text="{Binding KindBadge}"
                                             IsVisible="{Binding !HasLogo}"
                                             FontSize="10.5"
                                             FontWeight="Bold"
                                             Foreground="{DynamicResource Kp.BadgeFg}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                  <Image Source="{Binding Logo}"
                                         IsVisible="{Binding HasLogo}"
                                         Width="22"
                                         Height="22" />
                                </Panel>
                              </Border>
                              <StackPanel Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center" Spacing="3">
                                <Grid ColumnDefinitions="*,Auto">
                                  <TextBlock Text="{Binding Address}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                  <PathIcon Grid.Column="1" Data="{StaticResource Icon.Star}" Width="14" Height="14" Foreground="{DynamicResource Kp.Star}" Margin="6,0,0,0" VerticalAlignment="Center" IsVisible="{Binding Favorite}" />
                                </Grid>
                                <TextBlock Text="{Binding Username}" Classes="muted mono" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <ItemsControl ItemsSource="{Binding Tags}" Height="20" Margin="0,2,0,0" ClipToBounds="True">
                                  <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                      <views:TagStrip />
                                    </ItemsPanelTemplate>
                                  </ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                      <views:TagChip Text="{Binding}" />
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>

          <TextBlock Grid.Row="5" Text="{Binding AutofillHint}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" Margin="2,8,0,0" />
        </Grid>

        <!-- 右侧详情 -->
        <Border Grid.Column="1"
                Width="480"
                Classes="panel"
                Background="{DynamicResource Kp.Bg}"
                BorderBrush="{DynamicResource Kp.Border}"
                BorderThickness="1,0,0,0"
                IsVisible="{Binding HasDetail}">
          <Grid RowDefinitions="Auto,*,Auto" Margin="28,44,28,18">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,12">
              <Border Classes="count-badge" VerticalAlignment="Center">
                <TextBlock Text="{Binding KindName}" />
              </Border>
              <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="h1" TextWrapping="Wrap" Margin="10,0,8,0" VerticalAlignment="Center" />
              <Button Grid.Column="2" Classes="icon" Width="32" Height="32" ToolTip.Tip="{Binding FavoriteText}" VerticalAlignment="Top" Click="OnToggleFavorite">
                <Panel>
                  <PathIcon Data="{StaticResource Icon.StarOutline}" Width="19" Height="19" IsVisible="{Binding !Favorite}" />
                  <PathIcon Data="{StaticResource Icon.Star}" Width="19" Height="19" Foreground="{DynamicResource Kp.Star}" IsVisible="{Binding Favorite}" />
                </Panel>
              </Button>
              <Button Grid.Column="3" Classes="ghost" Content="关闭" VerticalAlignment="Top" Click="OnCloseDetail" />
            </Grid>
            <Panel Grid.Row="1">
              <ScrollViewer Margin="0,0,-20,0">
                <StackPanel Spacing="2" Margin="0,0,20,0">
                  <Border Classes="field">
                    <StackPanel>
                      <TextBlock Text="条目名称" Classes="field-label" />
                      <TextBox Text="{Binding Name}" Classes="inline" />
                    </StackPanel>
                  </Border>

                  <Border Classes="field">
                    <StackPanel>
                      <TextBlock Text="空间分类" Classes="field-label" />
                      <views:LabelPicker x:Name="SpacePicker"
                                         Items="{Binding SpaceChoices}"
                                         Icon="{StaticResource Icon.Folder}"
                                         Watermark="选择或输入空间分类"
                                         CreateText="创建空间"
                                         Margin="0,8,0,0" />
                    </StackPanel>
                  </Border>

                  <Border Classes="field">
                    <StackPanel>
                      <TextBlock Text="账号标签" Classes="field-label" />
                      <views:LabelPicker x:Name="TagPicker"
                                         Items="{Binding TagChoices}"
                                         Multiple="True"
                                         Watermark="选择或输入标签"
                                         CreateText="创建标签"
                                         Margin="0,8,0,0" />
                    </StackPanel>
                  </Border>

                  <Border Classes="field" IsVisible="{Binding ShowProtocol}">
                    <StackPanel>
                      <TextBlock Text="协议" Classes="field-label" />
                      <ComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding SelectedProtocol}" HorizontalAlignment="Stretch" Margin="0,6,0,0">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="vault:ServerProtocol">
                            <TextBlock Text="{Binding Name}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>
                  </Border>

                  <Border Classes="field" IsVisible="{Binding ShowDriver}">
                    <StackPanel>
                      <TextBlock Text="数据库类型" Classes="field-label" />
                      <ComboBox ItemsSource="{Binding Drivers}" SelectedItem="{Binding SelectedDriver}" HorizontalAlignment="Stretch" Margin="0,6,0,0">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="vault:DatabaseDriver">
                            <TextBlock Text="{Binding Name}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>
                  </Border>

                  <ItemsControl ItemsSource="{Binding PresetFields}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:FieldEditorView">
                        <Border Classes="field">
                          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldBody}" ClipToBounds="False" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Border Classes="field" IsVisible="{Binding ShowSshInfo}">
                    <StackPanel Spacing="6">
                      <TextBlock Text="密钥信息" Classes="field-label" />
                      <Grid ColumnDefinitions="56,*,Auto" RowDefinitions="Auto,Auto">
                        <TextBlock Text="类型" Classes="muted" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding SshKeyType}" Classes="mono" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Text="指纹" Classes="muted" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SshFingerprint}" Classes="mono" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Row="1" Grid.Column="2" Classes="icon" ToolTip.Tip="复制指纹" Click="OnCopyFingerprint">
                          <PathIcon Data="{StaticResource Icon.Copy}" />
                        </Button>
                      </Grid>
                      <TextBlock Text="{Binding SshWarning}" IsVisible="{Binding HasSshWarning}" Foreground="{DynamicResource Kp.Danger}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding SshReferences}" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <Border Classes="field" IsVisible="{Binding ShowNodes}">
                    <StackPanel>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="集群节点（全部共用下方账号凭据）" Classes="field-label" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="soft" Padding="10,4" FontSize="12" Content="+ 添加节点" Click="OnAddNode" />
                      </Grid>
                      <ItemsControl ItemsSource="{Binding Nodes}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:NodeEditorView">
                            <Border BorderBrush="{DynamicResource Kp.Border}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                              <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                  <Button Grid.Column="1" Classes="icon" ToolTip.Tip="复制地址" Tag="{Binding}" Click="OnCopyNode">
                                    <PathIcon Data="{StaticResource Icon.Copy}" />
                                  </Button>
                                  <Button Grid.Column="2" Classes="ghost" Padding="8,3" FontSize="12" Content="移除" Tag="{Binding}" Click="OnRemoveNode" />
                                </Grid>
                                <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,6,Auto,6,Auto">
                                  <TextBox Text="{Binding Name}" Watermark="名称" />
                                  <TextBox Grid.Column="2" Text="{Binding Role}" Watermark="角色，例如 graphd / metad" />
                                  <TextBox Grid.Row="2" Text="{Binding Host}" Watermark="主机 / IP" Classes="mono" />
                                  <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Port}" Watermark="端口" Classes="mono" />
                                  <TextBox Grid.Row="4" Grid.ColumnSpan="3" Text="{Binding Service}" Watermark="服务类型，例如 graph / meta / storage" />
                                </Grid>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <Border Classes="field" IsVisible="{Binding HasCustomFields}">
                    <StackPanel>
                      <TextBlock Text="其他字段（旧版本保留的数据）" Classes="field-label" />
                      <ItemsControl ItemsSource="{Binding CustomFields}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:CustomFieldEditorView">
                            <StackPanel Margin="0,0,0,10">
                              <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Classes="count-badge" Margin="8,0,0,0">
                                  <TextBlock Text="{Binding TypeText}" FontSize="11" />
                                </Border>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
                                  <Button Classes="icon" ToolTip.Tip="{Binding RevealText}" IsVisible="{Binding Sensitive}" Tag="{Binding}" Click="OnRevealField">
                                    <Panel>
                                      <PathIcon Data="{StaticResource Icon.Eye}" IsVisible="{Binding !Revealed}" />
                                      <PathIcon Data="{StaticResource Icon.EyeOff}" IsVisible="{Binding Revealed}" />
                                    </Panel>
                                  </Button>
                                  <Button Classes="icon" ToolTip.Tip="复制" Tag="{Binding}" Click="OnCopyField">
                                    <PathIcon Data="{StaticResource Icon.Copy}" />
                                  </Button>
                                  <Button Classes="icon icon-danger" ToolTip.Tip="删除" Tag="{Binding}" Click="OnRemoveCustomField">
                                    <PathIcon Data="{StaticResource Icon.Trash}" />
                                  </Button>
                                </StackPanel>
                              </Grid>
                              <TextBox Text="{Binding Value}" PasswordChar="{Binding MaskChar}" Classes="mono" Margin="0,6,0,0" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <Border Classes="field">
                    <StackPanel>
                      <TextBlock Text="备注" Classes="field-label" />
                      <TextBox Text="{Binding Note}" Classes="inline" AcceptsReturn="True" MinHeight="68" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <Border Classes="field" IsVisible="{Binding ShowAccounts}">
                    <StackPanel>
                      <TextBlock Text="{Binding AccountsTitle}" Classes="field-label" />
                      <ItemsControl ItemsSource="{Binding Accounts}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:AccountEditorView">
                            <Border BorderBrush="{DynamicResource Kp.Border}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                              <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                  <TextBlock Text="账号" FontWeight="SemiBold" VerticalAlignment="Center" />
                                  <Button Grid.Column="1" Classes="icon icon-danger" ToolTip.Tip="删除账号" Tag="{Binding}" Click="OnRemoveAccount">
                                    <PathIcon Data="{StaticResource Icon.Trash}" />
                                  </Button>
                                </Grid>
                                <ContentControl Content="{Binding UsernameField}" ContentTemplate="{StaticResource FieldBody}" ClipToBounds="False" />
                                <StackPanel IsVisible="{Binding ShowAuth}" Spacing="6">
                                  <TextBlock Text="认证方式" Classes="field-label" />
                                  <StackPanel Orientation="Horizontal">
                                    <Button Classes="chip" Classes.selected="{Binding UsePasswordAuth}" Content="密码" Tag="{Binding}" Click="OnAccountAuthPassword" />
                                    <Button Classes="chip" Classes.selected="{Binding UseKeyAuth}" Content="SSH 密钥" Tag="{Binding}" Click="OnAccountAuthKey" />
                                  </StackPanel>
                                  <ComboBox ItemsSource="{Binding SshKeyOptions}"
                                            SelectedItem="{Binding SelectedSshKey}"
                                            PlaceholderText="选择要关联的 SSH 密钥条目"
                                            HorizontalAlignment="Stretch"
                                            IsVisible="{Binding ShowKeyPicker}">
                                    <ComboBox.ItemTemplate>
                                      <DataTemplate x:DataType="vm:KeyOptionView">
                                        <StackPanel>
                                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                          <TextBlock Text="{Binding Detail}" Classes="muted mono" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                      </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                  </ComboBox>
                                  <TextBlock Text="还没有 SSH 密钥条目，请先新建一条「SSH 密钥」。" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding ShowMissingKeyHint}" />
                                  <TextBlock Text="只保存对密钥条目的引用，不会复制私钥。" Classes="muted" FontSize="11.5" IsVisible="{Binding UseKeyAuth}" />
                                </StackPanel>
                                <ContentControl Content="{Binding PasswordField}" ContentTemplate="{StaticResource FieldBody}" ClipToBounds="False" IsVisible="{Binding ShowPassword}" />
                                <ContentControl Content="{Binding TotpField}" ContentTemplate="{StaticResource FieldBody}" ClipToBounds="False" IsVisible="{Binding ShowTotp}" />
                                <TextBlock Text="{Binding TotpPreview}" IsVisible="{Binding HasTotpPreview}" Classes="mono" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Kp.Accent}" LetterSpacing="2" />
                                <StackPanel>
                                  <TextBlock Text="账号说明" Classes="field-label" />
                                  <TextBox Text="{Binding Note}" Classes="inline" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" Watermark="例如：只读权限，仅用于报表查询" />
                                </StackPanel>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Button Classes="soft" Padding="10,4" FontSize="12" HorizontalAlignment="Right" Content="+ 添加账号" IsEnabled="{Binding CanAddAccount}" Click="OnAddAccount" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Panel>

            <DockPanel Grid.Row="2" Margin="0,14,0,0">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasDetail}">
                <Button Classes="danger" Click="OnDelete">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource Icon.Trash}" Width="14" Height="14" />
                    <TextBlock Text="删除" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Classes="accent" Click="OnSave" Padding="20,9">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource Icon.Check}" Width="14" Height="14" />
                    <TextBlock Text="保存修改" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
              <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Classes="muted" TextWrapping="Wrap" Margin="0,0,12,0" />
            </DockPanel>
          </Grid>
        </Border>
      </Grid>

      <Border x:Name="GeneratorPage" IsVisible="False" Background="{DynamicResource Kp.Bg}" Padding="0,32,0,0">
        <views:PasswordGeneratorView x:Name="GeneratorRoot" />
      </Border>

      <Border x:Name="TotpPage" IsVisible="False" Background="{DynamicResource Kp.Bg}" Padding="0,32,0,0">
        <views:TotpView x:Name="TotpRoot" />
      </Border>

      <Border x:Name="AuditPage" IsVisible="False" Background="{DynamicResource Kp.Bg}" Padding="0,32,0,0">
        <views:AuditView x:Name="AuditRoot" />
      </Border>

      <Border x:Name="BreachPage" IsVisible="False" Background="{DynamicResource Kp.Bg}" Padding="0,32,0,0">
        <views:BreachView x:Name="BreachRoot" />
      </Border>

      <Border x:Name="SettingsPage" IsVisible="False" Background="{DynamicResource Kp.Bg}" Padding="0,32,0,0">
        <views:SettingsView x:Name="SettingsRoot" />
      </Border>
    </Grid>
  </Grid>
  <views:UnlockView x:Name="UnlockRoot" />
  <Border Height="32" VerticalAlignment="Top" Background="Transparent" PointerPressed="OnTitleBarPressed" />
  </Panel>
</Window>
