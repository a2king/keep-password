<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KeepPassword.App.ViewModels"
        xmlns:views="using:KeepPassword.App.Views"
        x:Class="KeepPassword.App.Views.MainWindow"
        Title="Keep Password"
        Width="1360"
        Height="800"
        MinWidth="1040"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Kp.Bg}"
        Icon="/Assets/logo.png">
  <Panel>
  <Grid x:Name="VaultRoot" x:DataType="vm:MainViewModel" ColumnDefinitions="88,*" IsVisible="False">
    <!-- 左侧极客现代导航侧栏 -->
    <Border Background="{DynamicResource Kp.Sidebar}">
      <DockPanel Margin="0,16,0,12">
        <StackPanel DockPanel.Dock="Top" Spacing="6">
          <Image Source="/Assets/logo.png" Width="40" Height="40" HorizontalAlignment="Center" Margin="0,4,0,12" />
          <Button x:Name="NavItems" Classes="nav active" Click="OnNavItems" ToolTip.Tip="保险库条目">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource Icon.Vault}" Width="20" Height="20" />
              <TextBlock Text="条目" FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="NavGenerator" Classes="nav" Click="OnNavGenerator" ToolTip.Tip="密码生成器">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource Icon.Generator}" Width="20" Height="20" />
              <TextBlock Text="生成器" FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Click="OnTotp" ToolTip.Tip="双重验证码 (TOTP)">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource Icon.Totp}" Width="20" Height="20" />
              <TextBlock Text="验证码" FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Click="OnAudit" ToolTip.Tip="密码安全审计">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource Icon.Audit}" Width="20" Height="20" />
              <TextBlock Text="审计" FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Click="OnBreach" ToolTip.Tip="公开泄露检查">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource Icon.Breach}" Width="20" Height="20" />
              <TextBlock Text="泄露" FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Click="OnUsers" ToolTip.Tip="账户与偏好设置">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource Icon.Settings}" Width="20" Height="20" />
              <TextBlock Text="设置" FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- 侧栏底部：主题切换 + 锁定 -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="4" VerticalAlignment="Bottom">
          <Button x:Name="ThemeToggleButton" Classes="nav" Click="OnCycleTheme" ToolTip.Tip="点击切换：浅色 / 深色 / 跟随系统">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource Icon.Theme}" Width="19" Height="19" />
              <TextBlock x:Name="ThemeLabel" Text="主题" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes="nav" Click="OnLock" ToolTip.Tip="锁定保险库">
            <StackPanel Spacing="3" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource Icon.Lock}" Width="19" Height="19" />
              <TextBlock Text="锁定" FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding Account}" FontSize="10" Opacity="0.65" TextTrimming="CharacterEllipsis" MaxWidth="68" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <Border />
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid x:Name="ItemsPage" ColumnDefinitions="*,Auto">
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="20,16,20,12">
          <!-- 顶部：搜索 + 操作 + 空间下拉 -->
          <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,14">
            <Grid ColumnDefinitions="Auto,*">
              <TextBox Grid.ColumnSpan="2" Text="{Binding Search}" Watermark="搜索标签、账号、备注、网址、地址" Padding="34,8,12,8" />
              <PathIcon Data="{StaticResource Icon.Search}" Width="15" Height="15" Foreground="{DynamicResource Kp.TextMuted}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0">
              <Button Classes="soft" Content="导入 CSV" Click="OnImport" />
              <Button Classes="soft" Content="+ 登录" Click="OnNewLogin" />
              <Button Classes="soft" Content="+ 验证码" Click="OnNewTotp" />
            </StackPanel>
            <ComboBox Grid.Column="2"
                      Width="210"
                      Margin="10,0,0,0"
                      VerticalAlignment="Stretch"
                      ItemsSource="{Binding SpaceFilters}"
                      SelectedItem="{Binding SelectedSpaceFilter}"
                      ToolTip.Tip="选择空间分类">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:FilterItemView">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="1" Classes="count-badge" Margin="8,0,0,0">
                      <TextBlock Text="{Binding Count}" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>

          <!-- 标签卡片 -->
          <TextBlock Grid.Row="1" Text="标签" Classes="label" Margin="2,0,0,8" />
          <ScrollViewer Grid.Row="2" MaxHeight="128" Margin="0,0,0,10">
            <ItemsControl ItemsSource="{Binding TagFilters}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FilterItemView">
                  <Button Classes="filter-card" Classes.selected="{Binding IsSelected}" Tag="{Binding Key}" Click="OnTagFilter" Width="168" Margin="0,0,8,8">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <Border Grid.Column="1" Classes="count-badge" Margin="8,0,0,0">
                        <TextBlock Text="{Binding Count}" />
                      </Border>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- 账号卡片 -->
          <Grid Grid.Row="3" RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto" Margin="2,0,2,8">
              <TextBlock Text="账号" Classes="label" Margin="0" />
              <TextBlock Grid.Column="1" Text="{Binding EntryCountText}" Classes="muted" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Grid.Row="1"
                       Text="{Binding EmptyText}"
                       IsVisible="{Binding ShowEmpty}"
                       Classes="muted"
                       TextWrapping="Wrap"
                       Margin="4,12" />
            <ScrollViewer x:Name="AccountScroller" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding EntryRows}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:EntryRowView">
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="{Binding Columns}" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EntryItemView">
                          <Button Classes="account-card" Classes.selected="{Binding IsSelected}" Tag="{Binding Id}" Click="OnEntry" Margin="0,0,10,10">
                            <Grid ColumnDefinitions="44,*">
                              <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource Kp.BadgeBg}" VerticalAlignment="Top" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Initial}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Kp.BadgeFg}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                              </Border>
                              <StackPanel Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center" Spacing="3">
                                <TextBlock Text="{Binding Address}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Username}" Classes="muted mono" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Labels}" Classes="muted" FontSize="11.5" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasLabels}" />
                              </StackPanel>
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>

          <TextBlock Grid.Row="4" Text="{Binding AutofillHint}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" Margin="2,8,0,0" />
        </Grid>

        <!-- 右侧详情 -->
        <Border Grid.Column="1"
                Width="480"
                Classes="panel"
                Background="{DynamicResource Kp.Bg}"
                BorderBrush="{DynamicResource Kp.Border}"
                BorderThickness="1,0,0,0"
                IsVisible="{Binding HasDetail}">
          <Grid RowDefinitions="*,Auto" Margin="28,20,28,18">
            <Panel>
              <ScrollViewer>
                <StackPanel Spacing="2">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                    <TextBlock Text="{Binding Name}" Classes="h1" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Classes="ghost" Content="关闭" VerticalAlignment="Top" Click="OnCloseDetail" />
                  </Grid>
                  <TextBlock Text="{Binding Url}" Classes="muted mono" Margin="0,0,0,18" TextWrapping="Wrap" />

                  <Border Classes="field">
                    <StackPanel>
                      <TextBlock Text="条目名称" Classes="muted" FontWeight="SemiBold" />
                      <TextBox Text="{Binding Name}" Margin="0,6,0,0" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="28" />
                    </StackPanel>
                  </Border>

                  <Border Classes="field">
                    <StackPanel>
                      <TextBlock Text="网址" Classes="muted" FontWeight="SemiBold" />
                      <TextBox Text="{Binding Url}" Classes="mono" Watermark="https://example.com" Margin="0,6,0,0" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="28" />
                    </StackPanel>
                  </Border>

                  <Border Classes="field">
                    <StackPanel>
                      <TextBlock Text="用户名 / 账号" Classes="muted" FontWeight="SemiBold" />
                      <TextBox Text="{Binding Username}" Classes="mono" Margin="0,6,0,0" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="28" />
                    </StackPanel>
                  </Border>

                  <Border Classes="field">
                    <StackPanel>
                      <TextBlock Text="空间分类（单选，再次点击取消）" Classes="muted" FontWeight="SemiBold" />
                      <ItemsControl ItemsSource="{Binding SpaceChoices}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:LabelChipView">
                            <Button Classes="chip" Classes.selected="{Binding IsSelected}" Content="{Binding Name}" Tag="{Binding Name}" Click="OnChooseSpace" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="还没有空间分类，可在下方新增。" Classes="muted" Margin="0,4,0,6" IsVisible="{Binding !HasSpaceChoices}" />
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding NewSpaceText}" Watermark="新增空间分类，回车确认" KeyDown="OnNewSpaceKeyDown" />
                        <Button Grid.Column="1" Classes="soft" Content="新增" Margin="8,0,0,0" Click="OnAddSpace" />
                      </Grid>
                    </StackPanel>
                  </Border>

                  <Border Classes="field">
                    <StackPanel>
                      <TextBlock Text="账号标签（可多选）" Classes="muted" FontWeight="SemiBold" />
                      <ItemsControl ItemsSource="{Binding TagChoices}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:LabelChipView">
                            <Button Classes="chip" Classes.selected="{Binding IsSelected}" Content="{Binding Name}" Tag="{Binding Name}" Click="OnToggleTag" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="还没有账号标签，可在下方新增。" Classes="muted" Margin="0,4,0,6" IsVisible="{Binding !HasTagChoices}" />
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding NewTagText}" Watermark="新增账号标签，回车确认" KeyDown="OnNewTagKeyDown" />
                        <Button Grid.Column="1" Classes="soft" Content="新增" Margin="8,0,0,0" Click="OnAddTag" />
                      </Grid>
                    </StackPanel>
                  </Border>

                  <Border Classes="field">
                    <StackPanel>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="密码" Classes="muted" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="ghost" Padding="8,4" Click="OnTogglePassword">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon.Eye}" Width="14" Height="14" />
                            <TextBlock Text="{Binding PasswordToggleText}" FontSize="12" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </Grid>
                      <TextBox x:Name="PasswordBox"
                               Text="{Binding Password}"
                               PasswordChar="•"
                               Classes="mono"
                               FontSize="15"
                               Margin="0,6,0,0"
                               Background="Transparent"
                               BorderThickness="0"
                               Padding="0"
                               MinHeight="28" />
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                        <Button Classes="soft" Click="OnCopyPassword">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon.Copy}" Width="13" Height="13" />
                            <TextBlock Text="复制密码" FontSize="12" />
                          </StackPanel>
                        </Button>
                        <Button Classes="soft" Click="OnFillGenerated" IsVisible="{Binding IsNewLogin}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon.Generator}" Width="13" Height="13" />
                            <TextBlock Text="填入生成密码" FontSize="12" />
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <Border Classes="field">
                    <StackPanel>
                      <TextBlock Text="备注" Classes="muted" FontWeight="SemiBold" />
                      <TextBox Text="{Binding Note}" AcceptsReturn="True" MinHeight="68" TextWrapping="Wrap" Margin="0,6,0,0" Background="Transparent" BorderThickness="0" Padding="0" />
                    </StackPanel>
                  </Border>

                  <Border Classes="field">
                    <StackPanel>
                      <TextBlock Text="验证码密钥（Base32，可留空）" Classes="muted" FontWeight="SemiBold" />
                      <TextBox Text="{Binding TotpSecret}" Classes="mono" Watermark="手填 Base32 密钥" Margin="0,6,0,0" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="28" />
                      <TextBlock Text="{Binding TotpPreview}" Classes="mono" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Kp.Accent}" Margin="0,10,0,0" LetterSpacing="2.5" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Panel>

            <DockPanel Grid.Row="1" Margin="0,14,0,0">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasDetail}">
                <Button Classes="danger" Click="OnDelete">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource Icon.Trash}" Width="14" Height="14" />
                    <TextBlock Text="删除" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Classes="accent" Click="OnSave" Padding="20,9">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource Icon.Check}" Width="14" Height="14" />
                    <TextBlock Text="保存修改" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
              <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Classes="muted" TextWrapping="Wrap" Margin="0,0,12,0" />
            </DockPanel>
          </Grid>
        </Border>
      </Grid>

      <Border x:Name="GeneratorPage" IsVisible="False" Background="{DynamicResource Kp.Bg}">
        <views:PasswordGeneratorView x:Name="GeneratorRoot" />
      </Border>
    </Grid>
  </Grid>
  <views:UnlockView x:Name="UnlockRoot" />
  </Panel>
</Window>
