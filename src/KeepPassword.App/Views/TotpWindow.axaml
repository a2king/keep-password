<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KeepPassword.App.ViewModels"
        x:Class="KeepPassword.App.Views.TotpWindow"
        x:DataType="vm:TotpPageViewModel"
        Title="两步验证码 (TOTP)"
        Width="580"
        Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Kp.Bg}"
        Icon="/Assets/logo.png">
  <DockPanel Margin="26">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource Kp.SurfaceMuted}" BorderBrush="{DynamicResource Kp.Border}" BorderThickness="1">
          <PathIcon Data="{StaticResource Icon.Totp}" Width="18" Height="18" Foreground="{DynamicResource Kp.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="两步验证码 (TOTP)" Classes="h1" FontSize="20" />
          <TextBlock Text="实时计算当前有效的 6 位验证码，30 秒自动刷新。" Classes="muted" />
        </StackPanel>
      </StackPanel>
    </StackPanel>

    <TextBlock DockPanel.Dock="Top" Text="当前保险库中还没有包含验证码密钥的条目。" IsVisible="{Binding IsEmpty}" Classes="muted" Margin="0,16,0,0" HorizontalAlignment="Center" />

    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TotpRowView">
            <Border Background="{DynamicResource Kp.Surface}" CornerRadius="12" Padding="16,14" Margin="0,0,0,10" BorderBrush="{DynamicResource Kp.Border}" BorderThickness="1">
              <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                  <TextBlock Text="{Binding RemainingText}" Classes="muted mono" Margin="0,4,0,0" FontSize="12" />
                </StackPanel>
                <SelectableTextBlock Grid.Column="1"
                                     Text="{Binding Code}"
                                     Classes="mono"
                                     FontSize="28"
                                     FontWeight="Bold"
                                     LetterSpacing="2.5"
                                     Foreground="{DynamicResource Kp.Accent}"
                                     VerticalAlignment="Center"
                                     Margin="20,0" />
                <Button Grid.Column="2" Classes="soft" Click="OnCopy" Tag="{Binding Code}" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource Icon.Copy}" Width="13" Height="13" />
                    <TextBlock Text="复制" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
