<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KeepPassword.App.ViewModels"
        x:Class="KeepPassword.App.Views.UnlockWindow"
        x:DataType="vm:UnlockViewModel"
        Title="Keep Password"
        Width="480"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#151B2B"
        Icon="/Assets/logo.png">
  <Panel>
    <Border>
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#151B2B" Offset="0" />
          <GradientStop Color="#1F2A44" Offset="0.55" />
          <GradientStop Color="#0B4F9C" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <Border Classes="card" Margin="36" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="0">
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,18">
          <Image Source="/Assets/logo.png" Width="44" Height="44" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Keep Password" Classes="h1" FontSize="24" />
            <TextBlock Text="{Binding Title}" Classes="muted" />
          </StackPanel>
        </StackPanel>

        <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Classes="muted" Margin="0,0,0,8" />

        <TextBlock Text="{Binding AccountLabel}" Classes="label" IsVisible="{Binding !IsCreate}" />
        <TextBlock Text="账号" Classes="label" IsVisible="{Binding IsCreate}" />
        <TextBox Text="{Binding Account}" Watermark="例如 ada" IsVisible="{Binding IsCreate}" />

        <StackPanel IsVisible="{Binding NeedsMasterPassword}">
          <TextBlock Text="主密码" Classes="label" />
          <TextBox x:Name="MasterBox" PasswordChar="•" Watermark="主密码" />
        </StackPanel>

        <StackPanel IsVisible="{Binding IsCreate}">
          <TextBlock Text="确认主密码" Classes="label" />
          <TextBox x:Name="ConfirmMasterBox" PasswordChar="•" />
          <TextBlock Text="短密钥" Classes="label" />
          <TextBox x:Name="ShortBoxCreate" PasswordChar="•" Watermark="固定短密钥" />
          <TextBlock Text="确认短密钥" Classes="label" />
          <TextBox x:Name="ConfirmShortBox" PasswordChar="•" />
        </StackPanel>

        <StackPanel IsVisible="{Binding IsSoftUnlock}">
          <TextBlock Text="短密钥" Classes="label" />
          <TextBox x:Name="ShortBoxSoft" PasswordChar="•" Watermark="短密钥" />
        </StackPanel>

        <TextBlock Text="{Binding Error}" Foreground="#D14343" TextWrapping="Wrap" Margin="0,12,0,0" IsVisible="{Binding HasError}" />
        <TextBlock Text="正在处理…" Classes="muted" Margin="0,12,0,0" IsVisible="{Binding IsBusy}" />

        <Button Classes="accent" Content="{Binding SubmitText}" Margin="0,20,0,0" HorizontalAlignment="Stretch" Click="OnSubmit" IsEnabled="{Binding !IsBusy}" />
      </StackPanel>
    </Border>
  </Panel>
</Window>
