<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="using:KeepPassword.App.Controls.Details"
             x:Class="KeepPassword.App.Views.Details.ServerDetailView" x:CompileBindings="False">
  <StackPanel Spacing="10">
    <TextBlock Text="连接" FontSize="12" FontWeight="Medium" Margin="3,0,0,0" Foreground="{DynamicResource Detail.TextMuted}" />
    <d:DetailGroup Margin="0"><StackPanel x:Name="FieldHost" /></d:DetailGroup>
  </StackPanel>
</UserControl>
